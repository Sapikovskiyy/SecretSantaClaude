{
  "name": "santomi",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/optimize-assets.mjs",
    "deploy:demo": "npm run build:demo && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@rive-app/react-canvas": "^4.36.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.1"
  }
}
